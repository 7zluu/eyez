-- ==================== REACH EXTENDER ====================
reachConnection = nil

function startReach()
    if reachConnection then return end
    
    reachConnection = RunService.Heartbeat:Connect(function()
        if not reachEnabled then return end
        
        local character = player.Character
        if not character then return end
        
        local charhrp = character:FindFirstChild("HumanoidRootPart")
        if not charhrp then return end
        
        local liveFolder = workspace:FindFirstChild("Live")
        if liveFolder then
            for _, model in ipairs(liveFolder:GetChildren()) do
                if model:IsA("Model") and model ~= character then
                    local enemyHrp = model:FindFirstChild("HumanoidRootPart")
                    if enemyHrp then
                        local dist = (enemyHrp.Position - charhrp.Position).Magnitude
                        if dist <= reachStuds then
                            enemyHrp.Size = Vector3.new(reachStuds, reachStuds, reachStuds)
                            enemyHrp.CanCollide = false
                            enemyHrp.Massless = true
                        end
                    end
                end
            end
        end
    end)
end

function stopReach()
    if reachConnection then
        reachConnection:Disconnect()
        reachConnection = nil
    end
end

-- ==================== FLING ALL ====================
function isWhitelisted(playerName)
    if not flingAllWhitelistEnabled then return false end
    for _, name in ipairs(whitelist) do
        if name == playerName then
            return true
        end
    end
    return false
end

function flingAllPlayers()
    local liveFolder = workspace:FindFirstChild("Live")
    if not liveFolder then
        WindUI:Notify({
            Title = "Fling All",
            Content = "No Live folder found!",
            Duration = 3
        })
        return
    end
    
    task.spawn(function()
        local flinged = 0
        for _, model in ipairs(liveFolder:GetChildren()) do
            if model:IsA("Model") and model ~= player.Character then
                local targetPlayer = Players:GetPlayerFromCharacter(model)
                if targetPlayer then
                    if not isWhitelisted(targetPlayer.Name) then
                        local targetHrp = model:FindFirstChild("HumanoidRootPart")
                        if targetHrp then
                            targetHrp.Velocity = Vector3.new(0, 500, 0) + Vector3.new(
                                math.random(-100, 100),
                                0,
                                math.random(-100, 100)
                            )
                            targetHrp.RotVelocity = Vector3.new(
                                math.random(-100, 100),
                                math.random(-100, 100),
                                math.random(-100, 100)
                            )
                            flinged = flinged + 1
                            task.wait(flingAllDelay)
                        end
                    end
                end
            end
        end
        
        WindUI:Notify({
            Title = "Fling All",
            Content = "Flinged " .. flinged .. " players!",
            Duration = 3
        })
    end)
end

