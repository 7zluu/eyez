        if not autoTargetEnabled then return end

        local character = player.Character
        if not character then return end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end

        local liveFolder = workspace:FindFirstChild("Live")
        if not liveFolder then return end

        local myRoot = character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local closestEnemy = nil
        local closestDist = 100

        for _, model in ipairs(liveFolder:GetChildren()) do
            if model:IsA("Model") and model ~= character then
                local enemyHumanoid = model:FindFirstChildOfClass("Humanoid")
                if enemyHumanoid and enemyHumanoid.Health > 0 then
                    local enemyRoot = getRoot(model)
                    if enemyRoot then
                        local dist = (enemyRoot.Position - myRoot.Position).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closestEnemy = enemyRoot
                        end
                    end
                end
            end
        end

        if closestEnemy then
            local camCF = cam.CFrame
            cam.CFrame = CFrame.new(camCF.Position, closestEnemy.Position + Vector3.new(0, 1, 0))
        end
    end)
end

function stopAutoTarget()
    if autoTargetConnection then
        autoTargetConnection:Disconnect()
        autoTargetConnection = nil
    end
end

-- ==================== AUTO SPAM SKILLS ====================
function startAutoSpamSkills()
    if autoSpamSkillsConnection then return end

    autoSpamSkillsConnection = RunService.Heartbeat:Connect(function()
        if not autoSpamSkillsEnabled then return end
        if tick() - lastSpamTime < 0.15 then return end

        local character = player.Character
        if not character then return end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end

        local liveFolder = workspace:FindFirstChild("Live")
        if not liveFolder then return end

        local myRoot = character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        for _, model in ipairs(liveFolder:GetChildren()) do
            if model:IsA("Model") and model ~= character then
                local enemyHumanoid = model:FindFirstChildOfClass("Humanoid")
                if enemyHumanoid and enemyHumanoid.Health > 0 then
                    local enemyRoot = getRoot(model)
                    if enemyRoot then
                        local dist = (enemyRoot.Position - myRoot.Position).Magnitude

                        if dist <= 10 then
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
                            task.wait(0.02)
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
                            task.wait(0.02)
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Two, false, game)
                            task.wait(0.02)
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Two, false, game)
                            lastSpamTime = tick()
                            break
                        end
                    end
                end
            end
        end
    end)
end

function stopAutoSpamSkills()
    if autoSpamSkillsConnection then
        autoSpamSkillsConnection:Disconnect()
        autoSpamSkillsConnection = nil
    end
end

-- ==================== SAFE ZONE TP ====================
function startSafeZoneTP()
    if safeZoneTPConnection then return end

    safeZoneTPConnection = RunService.Heartbeat:Connect(function()
        if not safeZoneTPEnabled then return end
        if tick() - lastSafeZoneTP < 5 then return end

        local character = player.Character
        if not character then return end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local charhrp = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not charhrp then return end

        if humanoid.Health < humanoid.MaxHealth * 0.3 then
            local spawnLocation = workspace:FindFirstChild("SpawnLocation")
            if spawnLocation then
                charhrp.CFrame = spawnLocation.CFrame + Vector3.new(0, 5, 0)
                lastSafeZoneTP = tick()
            end
        end
    end)
end

function stopSafeZoneTP()
    if safeZoneTPConnection then
        safeZoneTPConnection:Disconnect()
        safeZoneTPConnection = nil
    end
end

