-- ==================== PARTE 2 - ESP SYSTEM ====================
function createESP(plr)
    if ESP.Objects[plr] then return ESP.Objects[plr] end

    local character = plr.Character
    if not character then return nil end

    local objects = {
        Box = nil,
        Tracer = nil,
        Name = nil,
        Distance = nil,
        HealthBar = nil
    }

    if ESP.Box then
        local box = Drawing.new("Square")
        box.Thickness = 1.5
        box.Color = ESP.BoxColor
        box.Filled = false
        box.Transparency = 1
        box.Visible = false
        box.ZIndex = 2
        objects.Box = box
    end

    if ESP.Tracers then
        local tracer = Drawing.new("Line")
        tracer.Color = ESP.TracerColor
        tracer.Thickness = 1.5
        tracer.Transparency = 1
        tracer.Visible = false
        tracer.ZIndex = 1
        objects.Tracer = tracer
    end

    if ESP.Names then
        local name = Drawing.new("Text")
        name.Text = plr.Name
        name.Color = ESP.TextColor
        name.Size = 14
        name.Center = true
        name.Outline = true
        name.OutlineColor = Color3.new(0, 0, 0)
        name.Visible = false
        name.ZIndex = 3
        objects.Name = name
    end

    if ESP.Distance then
        local dist = Drawing.new("Text")
        dist.Text = "0m"
        dist.Color = ESP.TextColor
        dist.Size = 12
        dist.Center = true
        dist.Outline = true
        dist.OutlineColor = Color3.new(0, 0, 0)
        dist.Visible = false
        dist.ZIndex = 3
        objects.Distance = dist
    end

    if ESP.Health then
        local healthBar = Drawing.new("Line")
        healthBar.Color = ESP.HealthColor
        healthBar.Thickness = 3
        healthBar.Transparency = 1
        healthBar.Visible = false
        healthBar.ZIndex = 4
        objects.HealthBar = healthBar
    end

    ESP.Objects[plr] = objects
    return objects
end

function removeESP(plr)
    local objects = ESP.Objects[plr]
    if not objects then return end

    if objects.Box then objects.Box:Remove() end
    if objects.Tracer then objects.Tracer:Remove() end
    if objects.Name then objects.Name:Remove() end
    if objects.Distance then objects.Distance:Remove() end
    if objects.HealthBar then objects.HealthBar:Remove() end

    ESP.Objects[plr] = nil
end

function updateESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local character = plr.Character

            if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Head") then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                local root = character:FindFirstChild("HumanoidRootPart")
                local head = character:FindFirstChild("Head")

                if humanoid and humanoid.Health > 0 then
                    local isEnemy = not ESP.TeamCheck or plr.Team ~= LocalPlayer.Team

                    if isEnemy then
                        local objects = ESP.Objects[plr] or createESP(plr)
                        if not objects then continue end

                        local distance = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude) or 0

                        if distance <= ESP.MaxDistance then
                            local headPos = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))
                            local rootPos = cam:WorldToViewportPoint(root.Position)

                            if objects.Box then
                                local top = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
                                local bottom = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 2.5, 0))

                                if top.Z > 0 and bottom.Z > 0 then
                                    local height = math.abs(top.Y - bottom.Y)
                                    local width = height * 0.6

                                    objects.Box.Size = Vector2.new(width, height)
                                    objects.Box.Position = Vector2.new(top.X - width/2, top.Y)
                                    objects.Box.Visible = true
                                else
                                    objects.Box.Visible = false
                                end
                            end

                            if objects.Tracer then
                                objects.Tracer.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                                objects.Tracer.To = Vector2.new(rootPos.X, rootPos.Y)
                                objects.Tracer.Visible = rootPos.Z > 0
                            end

                            if objects.Name then
                                objects.Name.Position = Vector2.new(headPos.X, headPos.Y - 25)
                                objects.Name.Visible = headPos.Z > 0
                            end

                            if objects.Distance then
                                objects.Distance.Text = string.format("%.0fm", distance)
                                objects.Distance.Position = Vector2.new(rootPos.X, rootPos.Y + 15)
                                objects.Distance.Visible = rootPos.Z > 0
                            end

                            if objects.HealthBar then
                                local healthPercent = humanoid.Health / humanoid.MaxHealth
                                local barHeight = 30 * healthPercent

                                objects.HealthBar.From = Vector2.new(rootPos.X - 25, rootPos.Y - barHeight/2)
                                objects.HealthBar.To = Vector2.new(rootPos.X - 25, rootPos.Y + barHeight/2)
                                objects.HealthBar.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
                                objects.HealthBar.Visible = rootPos.Z > 0
                            end
                        else
                            if objects.Box then objects.Box.Visible = false end
                            if objects.Tracer then objects.Tracer.Visible = false end
                            if objects.Name then objects.Name.Visible = false end
                            if objects.Distance then objects.Distance.Visible = false end
                            if objects.HealthBar then objects.HealthBar.Visible = false end
                        end
                    else
                        if ESP.Objects[plr] then
                            removeESP(plr)
                        end
                    end
                else
                    if ESP.Objects[plr] then
                        removeESP(plr)
                    end
                end
            else
                if ESP.Objects[plr] then
                    removeESP(plr)
                end
            end
        end
    end
end

